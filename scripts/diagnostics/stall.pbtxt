# Ten-minute, bounded, detached ring-buffer recording. No periodic disk flush:
# preserve recent history and flush when stopped or when the duration expires.
# Missing vendor/kernel events are not proof that the corresponding event did
# not happen. Inspect ftrace setup errors and trace data-loss stats on analysis.
duration_ms: 600000
write_into_file: true
file_write_period_ms: 1000000000
max_file_size_bytes: 33554432
buffers { size_kb: 24576 fill_policy: RING_BUFFER }
buffers { size_kb: 2048 fill_policy: RING_BUFFER }
data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      compact_sched { enabled: true }
      drain_period_ms: 1000
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "sched/sched_wakeup_new"
      ftrace_events: "sched/sched_process_exit"
      ftrace_events: "sched/sched_process_free"
      ftrace_events: "sched/sched_blocked_reason"
      ftrace_events: "task/task_newtask"
      ftrace_events: "task/task_rename"
      ftrace_events: "power/suspend_resume"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "cgroup/cgroup_freeze"
      ftrace_events: "cgroup/cgroup_unfreeze"
      ftrace_events: "cgroup/cgroup_notify_frozen"
      ftrace_events: "binder/binder_transaction"
      ftrace_events: "binder/binder_transaction_received"
      ftrace_events: "ftrace/print"
      atrace_categories: "am"
      atrace_categories: "power"
    }
  }
}
data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config { scan_all_processes_on_start: true }
  }
}
